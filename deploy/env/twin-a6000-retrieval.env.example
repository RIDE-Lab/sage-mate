# Private-LAN retrieval services on A6000-5. Install outside Git as
# %h/.config/sage-mate/twin-retrieval.env (mode 0600) and adjust host if needed.
DIGITAL_TWIN_KNOWLEDGE_BACKEND=sagevdb
DIGITAL_TWIN_SAGEVDB_BACKEND=sage-anns
DIGITAL_TWIN_SAGEVDB_ANNS_ALGORITHM=faiss_hnsw
DIGITAL_TWIN_SAGEVDB_EMBEDDING_BACKEND=openai
DIGITAL_TWIN_SAGEVDB_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
DIGITAL_TWIN_SAGEVDB_EMBEDDING_BASE_URL=http://11.11.11.34:18021/v1
DIGITAL_TWIN_SAGEVDB_EMBEDDING_API_KEY=
DIGITAL_TWIN_SAGEVDB_DIMENSION=4096
DIGITAL_TWIN_SAGEVDB_EMBEDDING_BATCH_SIZE=4
DIGITAL_TWIN_SAGEVDB_RERANKER_ENABLED=true
DIGITAL_TWIN_SAGEVDB_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
DIGITAL_TWIN_SAGEVDB_RERANKER_BASE_URL=http://11.11.11.34:18022/v1
DIGITAL_TWIN_SAGEVDB_RERANKER_API_KEY=

# Leave the dedicated model keys unset for these private-LAN services. If a
# model endpoint requires authentication later, inject its own key into the
# runtime environment; never reuse DIGITAL_TWIN_API_KEY.
