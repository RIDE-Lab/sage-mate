# Short canonical published discipline (searched as a phrase), not a description. Never include private profile or conversation data.
DIGITAL_TWIN_WEB_SEARCH_PUBLIC_CONTEXT="Computer systems"
DIGITAL_TWIN_WEB_SEARCH_TIMEOUT_SECONDS=12
DIGITAL_TWIN_WEB_RESEARCH_TIMEOUT_SECONDS=35
# Keep existing TAVILY_TOKEN / TAVILY_API_KEY in the private service environment.

# Requires SAGE[structured-output] and the verified vLLM grammar endpoint.
DIGITAL_TWIN_LLM_STRUCTURED_OUTPUT_BACKEND=vllm_grammar

# Qwen3.5 published non-thinking prose profile; source-audit classifiers stay neutral.
# https://huggingface.co/Qwen/Qwen3.5-35B-A3B#best-practices
DIGITAL_TWIN_LLM_ANSWER_TEMPERATURE=0.7
DIGITAL_TWIN_LLM_ANSWER_TOP_P=0.8
DIGITAL_TWIN_LLM_ANSWER_TOP_K=20
DIGITAL_TWIN_LLM_ANSWER_PRESENCE_PENALTY=1.5
DIGITAL_TWIN_LLM_ANSWER_FREQUENCY_PENALTY=0.0
DIGITAL_TWIN_LLM_ANSWER_REPETITION_PENALTY=1.0
DIGITAL_TWIN_LLM_EVIDENCE_AUDIT_THINKING=true
# Native precision-oriented reasoning profile; no application thinking-token cap.
DIGITAL_TWIN_LLM_THINKING_TEMPERATURE=0.6
DIGITAL_TWIN_LLM_THINKING_TOP_P=0.95
DIGITAL_TWIN_LLM_THINKING_TOP_K=20
