[Unit]
Description=Sage Mate vLLM-HUST inference engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/tools/run_vllm_engine.sh
ExecStop=__REPO_ROOT__/tools/cleanup_vllm_engine.sh
Restart=on-failure
RestartSec=10
# Model loading can need generous startup time.
TimeoutStartSec=600
TimeoutStopSec=90
# Container workers live outside this user unit's cgroup. ExecStop owns their
# bounded cleanup before systemd terminates only the host launcher.
KillMode=process

[Install]
WantedBy=default.target
