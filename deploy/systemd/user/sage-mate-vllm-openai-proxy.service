[Unit]
Description=Sage Mate OpenAI-compatible vLLM proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=PYTHON_BIN=__PYTHON_BIN__
ExecStart=__REPO_ROOT__/tools/run_vllm_openai_proxy.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
