[Unit]
Description=Sage Mate application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=PYTHON_BIN=__PYTHON_BIN__
# Optional calendar bridge settings are loaded from .env by tools/run_app_server.sh.
ExecStart=__REPO_ROOT__/tools/run_app_server.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
